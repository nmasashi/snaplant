{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node20",
    "lib": ["ES2020", "ES2022.Intl"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    // ts-jest が module: node20 (hybrid module kind) では isolatedModules を要求するため
    // （未設定だとテスト実行ごとに TS151002 の警告が出る）
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}