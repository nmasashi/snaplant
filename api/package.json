{
  "name": "snaplant-api",
  "version": "1.0.0",
  "description": "SnapPlant Azure Functions API with Azure OpenAI integration",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "func start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prestart": "npm run build && func extensions install",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.16.5",
    "@azure/storage-blob": "^12.33.0",
    "openai": "^7.20.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
