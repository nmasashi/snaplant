# Project configuration
project_name = "snaplant"
# 実際の本番デプロイ先は West Europe。
# variables.tf の既定値は Japan East だが、この値で上書きしている。
# ここを変えると既存リソースとは別のリージョンに新しく作られる
location = "West Europe"

# Cosmos DB configuration
cosmos_db_consistency_level = "Session"
cosmos_db_throughput        = 400 # Free tier limit

# Azure Functions configuration
functions_plan_tier = "Y1" # Consumption plan (cheapest)

# Storage configuration
storage_account_tier     = "Standard"
storage_replication_type = "LRS" # Locally redundant storage (cheapest)

# Application Insights configuration
application_insights_type = "web"

# Azure OpenAI configuration
#
# API キーをここに書く必要はない。Terraform が
# azurerm_cognitive_account.openai を作成し、その primary_access_key を
# Function App の app_settings へ直接流し込む。
#
# openai_location は location とは別。使うモデル（今は gpt-6-luna）が使えるリージョンが
# 限られているため、OpenAI だけ別リージョンに置いている
openai_location    = "East US"
openai_sku         = "S0"
openai_api_version = "2024-12-01-preview"

# 予算アラート（段階3）。金額は請求の通貨（円の想定）。メールアドレスはここ（terraform.tfvars）にだけ書く
monthly_budget_amount = 3000
budget_alert_email    = "you@example.com"

# Tags for resource management
tags = {
  Project     = "SnapPlant"
  ManagedBy   = "Terraform"
  CostCenter  = "Development"
  Environment = "Production"
}
